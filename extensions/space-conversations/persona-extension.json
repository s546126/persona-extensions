{
  "manifest_version": 1,
  "id": "space-conversations",
  "name": "空间对话",
  "version": "0.3.0",
  "icon": "assets/icon.png",
  "description": "为生活的不同部分建立独立空间，保留各自的 SPACE.md、记忆边界和 Persona 对话。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/docs/extensions/space-conversations.md",
  "tags": ["空间", "对话", "记忆", "项目"],
  "engines": {"extension_protocol": 1},
  "runtime": {"command": {
    "linux-amd64": "bin/space-conversations-linux-amd64",
    "linux-arm64": "bin/space-conversations-linux-arm64",
    "darwin-amd64": "bin/space-conversations-darwin-amd64",
    "darwin-arm64": "bin/space-conversations-darwin-arm64"
  }},
  "contributes": {
    "track_kinds": [{
      "id": "space",
      "title": "空间",
      "config": {
        "schema": 1,
        "template": "space",
        "user_instructions": "space_md",
        "context": "track",
        "default_categories": [],
        "tag_focus": [],
        "rhythms": [],
        "attention": {"push_cap": "P0", "deep_default": "quick", "enter_mode": "none"},
        "supervision": "none",
        "usage": [],
        "assembly": "track",
        "capture_target": true,
        "channels": ["topics", "single"],
        "sidebar": {"group": "spaces"}
      }
    }],
    "ui": [
      {"id": "home", "title": "空间对话", "placement": "nav_page", "icon": "chat"},
      {"id": "space", "title": "空间", "placement": "extension_page"},
      {"id": "new", "title": "新建空间", "placement": "extension_page"},
      {"id": "edit", "title": "编辑 SPACE.md", "placement": "extension_page"}
    ]
  },
  "permissions": {"hub": ["spaces", "assistant.ask"]}
}
