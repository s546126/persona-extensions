{
  "manifest_version": 1,
  "id": "water",
  "name": "喝水提醒",
  "version": "0.4.1",
  "icon": "assets/icon.png",
  "description": "按时提醒喝水，通知上一点就记，随时看今天的进度和最近每天喝了多少，提醒不用模型。表盘和小组件也能看今天的喝水进度。也能用快捷指令和 Siri 记一杯水。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/docs/extensions/water.md",
  "tags": ["健康", "喝水", "提醒", "习惯"],
  "engines": {"extension_protocol": 1},
  "activation_events": ["on_startup"],
  "runtime": {"command": {
    "linux-amd64": "bin/water-linux-amd64",
    "linux-arm64": "bin/water-linux-arm64",
    "darwin-arm64": "bin/water-darwin-arm64",
    "darwin-amd64": "bin/water-darwin-amd64"
  }},
  "contributes": {"ui": [
    {"id": "water", "title": "喝水", "placement": "nav_page", "icon": "droplet"},
    {"id": "water-today", "title": "今天喝水", "placement": "widget", "families": ["small", "medium", "accessory_circular", "accessory_rectangular", "accessory_inline"], "refresh_minutes": 30, "opens": "water"}
  ], "shortcuts": [
    {"id": "log_water", "title": "记一杯水", "description": "记一杯水；填了毫升数就按填的量记。", "params": [{"name": "amount", "title": "毫升", "kind": "number"}], "ui": "water"}
  ]},
  "permissions": {"hub": ["notify"]},
  "configuration": {
    "type": "object",
    "properties": {
      "remind": {"type": "boolean", "default": true, "title": "开启提醒", "description": "关掉后仍可记录，只是不发通知。"},
      "goal_ml": {"type": "integer", "default": 2000, "minimum": 500, "maximum": 6000, "title": "每天目标（毫升）"},
      "cup_ml": {"type": "integer", "default": 250, "minimum": 50, "maximum": 1000, "title": "一杯多少（毫升）"},
      "start": {"type": "string", "default": "09:00", "title": "开始提醒", "description": "格式 HH:MM，要早于结束时间。", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
      "end": {"type": "string", "default": "21:00", "title": "结束提醒", "description": "格式 HH:MM，包含这个时间点。", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
      "interval_minutes": {"type": "integer", "default": 60, "minimum": 15, "maximum": 240, "title": "间隔（分钟）"},
      "weekends": {"type": "boolean", "default": true, "title": "周末也提醒"},
      "stop_when_done": {"type": "boolean", "default": true, "title": "喝够了今天就不再提醒"}
    }
  }
}
