{
  "manifest_version": 1,
  "id": "volc",
  "name": "火山语音",
  "version": "1.0.0",
  "publisher": "nwverse",
  "icon": "assets/icon.png",
  "description": "用你的火山引擎（豆包语音）账号做会议的 Hub 转录，并在会议设成「参与者」时把回答念出来。",
  "homepage": "https://www.volcengine.com/product/voice-tech",
  "engines": {"extension_protocol": 1, "persona": ">=202611272113"},
  "runtime": {"http": true, "command": {
    "linux-amd64": "bin/volc-linux-amd64",
    "linux-arm64": "bin/volc-linux-arm64",
    "darwin-amd64": "bin/volc-darwin-amd64",
    "darwin-arm64": "bin/volc-darwin-arm64"
  }},
  "activation_events": ["on_startup"],
  "permissions": {"network": ["openspeech.bytedance.com"]},
  "contributes": {
    "transcription": [{"id": "volc", "name": "火山引擎"}],
    "speech": [{"id": "volc", "name": "火山引擎"}],
    "ui": [{"id": "status", "title": "连接与测试", "placement": "extension_page"}]
  },
  "settings_check": true,
  "secrets": [{
    "name": "key",
    "title": "API Key",
    "hint": "last4",
    "required": true,
    "description": "在豆包语音控制台「API Key管理」复制。首次保存后会测一次识别和合成，结果见「连接与测试」。"
  }],
  "configuration": {
    "type": "object",
    "properties": {
      "read_answers": {
        "type": "boolean",
        "default": true,
        "title": "参与者回答用火山朗读",
        "description": "会议设成「参与者」时，用下面的音色念 Persona 的回答；关掉或出错时用手机自带的声音。"
      },
      "voice": {
        "type": "string",
        "title": "音色",
        "default": "zh_female_vv_uranus_bigtts",
        "oneOf": [
          {"const": "zh_female_vv_uranus_bigtts", "title": "Vivi（女声，多语种）"},
          {"const": "zh_female_xiaohe_uranus_bigtts", "title": "小何（女声）"},
          {"const": "zh_male_m191_uranus_bigtts", "title": "云舟（男声）"},
          {"const": "zh_male_taocheng_uranus_bigtts", "title": "小天（男声）"},
          {"const": "zh_female_qingxinnvsheng_uranus_bigtts", "title": "清新女声"},
          {"const": "zh_female_shuangkuaisisi_uranus_bigtts", "title": "爽快思思（女声）"}
        ]
      },
      "advanced": {
        "type": "object",
        "title": "高级",
        "properties": {
          "asr_model": {
            "type": "string",
            "title": "识别模型",
            "description": "要在豆包语音控制台开通对应的模型。",
            "default": "volc.seedasr.sauc.duration",
            "oneOf": [
              {"const": "volc.seedasr.sauc.duration", "title": "豆包 2.0，按时长计费（默认）"},
              {"const": "volc.seedasr.sauc.concurrent", "title": "豆包 2.0，按并发计费"},
              {"const": "volc.bigasr.sauc.duration", "title": "1.0，按时长计费"},
              {"const": "volc.bigasr.sauc.concurrent", "title": "1.0，按并发计费"}
            ]
          },
          "voice_id": {
            "type": "string",
            "title": "其他音色 ID",
            "pattern": "^[A-Za-z0-9_.-]{0,128}$",
            "description": "从豆包语音控制台「音色库」复制的音色 ID；填了就代替上面的音色。"
          },
          "app_id": {
            "type": "string",
            "title": "App ID（旧版控制台）",
            "pattern": "^[A-Za-z0-9_-]{0,64}$",
            "description": "只在用旧版控制台的 App ID 和 Access Token 时填，这时上面的 API Key 栏填 Access Token。"
          }
        }
      }
    }
  }
}
